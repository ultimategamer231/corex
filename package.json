{
  "name": "corex",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "check": "pnpm format:check && pnpm lint:root && pnpm typecheck:root && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:root": "eslint . --max-warnings=0",
    "typecheck:root": "tsc --noEmit",
    "db:local:start": "node scripts/supabase-local.mjs start",
    "db:local:stop": "node scripts/supabase-local.mjs stop",
    "db:local:status": "node scripts/supabase-local.mjs status",
    "db:local:check": "node scripts/supabase-local.mjs check",
    "db:migrate": "node packages/db/src/cli/migrate.ts",
    "db:migrate:all": "node packages/db/src/cli/migrate-all.ts",
    "db:provision": "node packages/db/src/cli/provision.ts",
    "db:backup": "node packages/db/src/cli/backup.ts",
    "db:restore": "node packages/db/src/cli/restore.ts",
    "db:types": "node scripts/gen-types.mjs",
    "db:fixture": "node packages/db/src/cli/fixture.ts",
    "demo:seed": "node packages/db/src/cli/demo-seed.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@corex/config": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "catalog:",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "supabase": "2.122.0",
    "turbo": "2.11.10",
    "typescript": "catalog:"
  }
}
