# Corex Admin environment variables (SPEC-ADMIN.md 2).
# Copy to .env.local for development. Never commit real values.

# Supabase project that holds corex_web (the website project). Local stack: run
# `pnpm db:local:status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Public (publishable or anon) key. Row-level security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: team management, sign-in records and the activity log. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Schema with the admin data (default corex_web).
NEXT_PUBLIC_DB_SCHEMA=corex_web

# Base address of the admin, used in emailed and copied links. Production:
# https://admin.corexlr.com
NEXT_PUBLIC_ADMIN_URL=http://localhost:3008

# Email through Resend. Until a sending domain is verified, Resend delivers only to
# the Resend account's own address (password resets of that admin still work).
RESEND_API_KEY=
# Sender on the domain verified in Resend. Production: Corex <billing@corexlr.com>
EMAIL_FROM=
# true once corexlr.com is verified in Resend (docs/go-live.md); while false, client
# emails stay off and invoices are shared by PDF and WhatsApp (SPEC-ADMIN.md 9.6).
CLIENT_EMAIL_ENABLED=false

# Server only: signs the "trust this device" cookie. At least 32 random characters,
# for example the output of `openssl rand -base64 48`.
TRUSTED_DEVICE_SECRET=

# Server only: the daily check (/api/cron/daily) runs only with this secret, sent by the
# "Admin daily check" GitHub workflow (secret ADMIN_CRON_SECRET, variable ADMIN_URL).
# At least 32 random characters, for example the output of `openssl rand -base64 48`.
CRON_SECRET=
