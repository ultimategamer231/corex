# School Management environment variables (SPEC.md 4.2).
# Copy to .env.local for development. Never commit real values.

# Supabase project this instance uses. Local stack: run `pnpm db:local:status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Public anon key. Row-level security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Used for provisioning, seeding and admin user creation. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres schema and storage bucket for this client, for example client_bethel_school.
NEXT_PUBLIC_DB_SCHEMA=demo_college
NEXT_PUBLIC_STORAGE_BUCKET=demo_college

# College/University or High School edition (SPEC.md 7)
EDITION=college

# true on the public demo instances (SPEC.md 11.3). A demo also needs
# SUPABASE_SERVICE_ROLE_KEY (sign-in rate limit) and NEXT_PUBLIC_DB_SCHEMA=demo_college
# or demo_highschool; seed it with `pnpm demo:seed --demo college|highschool`.
DEMO_MODE=false

# Optional, server-only: overrides NEXT_PUBLIC_DB_SCHEMA at run time without a rebuild.
DB_SCHEMA=

# Public address of this instance, used in password reset emails.
APP_URL=http://localhost:3001

# Root domain of the Corex website, used for "Get this system" links in demo mode.
NEXT_PUBLIC_ROOT_DOMAIN=
