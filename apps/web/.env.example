# Corex website environment variables (SPEC.md 4.2, 6.6).
# Copy to .env.local for development. Never commit real values.

# Public address of this site, used for canonical links, sitemap and social cards.
# Production: https://corexlr.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Root domain used to build demo links (demo-college.corexlr.com, ...). Production: corexlr.com
NEXT_PUBLIC_ROOT_DOMAIN=
# Only for demos hosted without the domain; leave empty in production. {subdomain} becomes
# demo-college, demo-school, demo-clinic or demo-finance, e.g. corex-{subdomain}.vercel.app
NEXT_PUBLIC_DEMO_HOST_PATTERN=

# Supabase project that holds corex_web (separate from client and demo data).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Server only: the website stores leads with this key (owner decision, PROGRESS.md). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Schema that holds leads and rate limits (default corex_web).
LEADS_SCHEMA=corex_web
# "memory" keeps leads in memory (development and e2e). Production refuses to start
# taking quotes without the Supabase settings above, so leads are never lost silently.
LEAD_STORE=

# Optional: email the team about each new lead through Resend. All three must be set.
# Production: LEAD_NOTIFY_TO=hello@corexlr.com, LEAD_NOTIFY_FROM=Corex Website <website@corexlr.com>
RESEND_API_KEY=
LEAD_NOTIFY_TO=
LEAD_NOTIFY_FROM=
